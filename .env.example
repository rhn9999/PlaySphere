# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (both MONGODB_URI and MONGO_URI supported)
MONGODB_URI=mongodb://localhost:27017/khelnow
MONGO_URI=mongodb://localhost:27017/khelnow

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_khelnow_production_grade_token_signing_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGIN=*

# OpenStreetMap Nominatim API endpoint (No API key required; rate-limited to 1 req/sec)
NOMINATIM_API=https://nominatim.openstreetmap.org

# Firebase Cloud Messaging (FCM) - OPTIONAL
# If credentials are not provided, push notifications will be gracefully skipped.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
